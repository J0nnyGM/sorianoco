rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA ---
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      // Aseguramos que data no sea null antes de acceder a role
      return getUserData() != null && getUserData().role == 'admin';
    }
    
    function isContabilidad() {
      return getUserData().role == 'contabilidad' || isAdmin();
    }
    
    function isVendedor() {
      return getUserData().role == 'vendedor' || isAdmin();
    }
    
    function isActive() {
      return request.auth != null && getUserData().status == 'active';
    }

    // --- REGLAS POR COLECCIÓN ---

    // 1. USUARIOS
    match /users/{userId} {
      allow create: if request.auth != null; // Permitir registro inicial
      allow read: if request.auth != null; 
      allow update, delete: if isAdmin();
    }

    // 2. INVENTARIO & PROVEEDORES
    match /inventory/{itemId} {
      allow read: if isActive();
      // Permitimos update a vendedores para descontar stock
      allow create, update: if isContabilidad() || isVendedor(); 
      allow delete: if isAdmin();
    }
    match /suppliers/{supId} {
      allow read: if isActive();
      allow write: if isContabilidad();
    }

    // 3. COMPRAS & GASTOS
    match /purchases/{docId} {
      allow read, write: if isContabilidad();
    }
    match /expenses/{docId} {
      allow read, write: if isContabilidad();
    }

    // 4. CLIENTES
    match /clients/{clientId} {
      allow read: if isActive();
      allow write: if isVendedor(); // Admin tambien es vendedor segun la funcion
    }

    // 5. ÓRDENES DE PRODUCCIÓN
    match /orders/{orderId} {
      allow read: if isActive();
      allow create: if isVendedor(); // Aquí fallaba si no eras admin/vendedor
      allow update: if isActive(); 
      allow delete: if isAdmin();
    }

    // 6. TRABAJOS EXTERNOS
    match /external_jobs/{jobId} {
      allow read: if isActive();
      allow write: if isContabilidad();
    }

    // 7. TESORERÍA (CUENTAS)
    match /accounts/{accountId} {
      allow read: if isActive(); 
      allow write: if isContabilidad() || isVendedor(); 
    }

    // 8. LOG DE TRANSACCIONES
    match /transactions/{txId} {
      allow read: if isActive();
      allow create: if isActive();
    }
    
    // 9. AUDITORÍA
    match /audit_deleted_expenses/{logId} {
      allow read: if isContabilidad();
      allow create: if isActive();
    }

    // 10. CONTADORES (¡ESTO FALTABA!)
    // Necesario para generar el ID consecutivo (Order #1, #2...)
    match /counters/{counterId} {
      allow read: if isActive();
      allow update: if isActive(); // Cualquier usuario activo puede incrementar el contador
      allow create: if isAdmin();  // Solo el admin crea el contador inicial (si no existe)
    }

  }
}